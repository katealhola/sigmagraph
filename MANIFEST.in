include LICENSE THIRD_PARTY_NOTICES.md README.md CONTRIBUTING.md CHANGELOG.md
include run.py requirements*.txt
recursive-include LICENSES *.txt
recursive-include docs *.md
recursive-include examples *.sgproj
recursive-include tests *.py
recursive-include scripts *.py
recursive-include tools *.py *.md *.txt
recursive-include .github *.yml *.md
prune .build
prune dist
prune artifacts
prune .venv
prune .git
global-exclude __pycache__ *.py[cod] .DS_Store
